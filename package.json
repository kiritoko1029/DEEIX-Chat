{
  "name": "@deeix/chat-monorepo",
  "version": "2026.11.12",
  "private": true,
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@deeix/api",
    "dev:web": "turbo run dev --filter=@deeix/web",
    "dev:desktop": "turbo run dev --filter=@deeix/desktop",
    "build": "turbo run build",
    "check": "turbo run check",
    "test": "turbo run test",
    "verify": "turbo run check test build",
    "clean": "turbo run clean",
    "api:generate": "pnpm --filter @deeix/api-contract generate",
    "api:check": "pnpm --filter @deeix/api-contract check"
  },
  "devDependencies": {
    "turbo": "2.10.5"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "3.4.17",
      "fast-uri": "4.2.3",
      "js-yaml": ">=4.3.2",
      "katex": "^0.18.11"
    }
  }
}
